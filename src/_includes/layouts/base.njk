<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta property="og:title" content="{{ title | default('ErikG') }}" />
    <meta property="og:description" content="Where am I? What is this? Oh, it's just art." />
    <meta property="og:image" content="https://erikg.org/banner.png" />
    <title>{{ title | default('ErikG') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;1,300&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/base.css" />
    <link rel="stylesheet" href="/styles/custom.css" />
    <link rel="stylesheet" href="/styles/prism-mono.css">
    {% if script %}<script type="module" src="{{ script }}"></script>{% endif %}
    {% if styles %}<link rel="stylesheet" href="{{ styles }}" />{% endif %}
</head>
<body>
    {% if not isHome %}{% include "partials/header.njk" %}{% endif %}
    <hr />
    <main>{{ content | safe }}</main>
    {% if not isHome %}{% include "partials/footer.njk" %}{% endif %}
</body>
</html>
